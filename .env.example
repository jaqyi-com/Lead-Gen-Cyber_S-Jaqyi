# ─── Apify ────────────────────────────────────────────────────────────────────
# Get from https://console.apify.com/account/integrations
APIFY_TOKEN=

# ─── AI — OpenRouter ──────────────────────────────────────────────────────────
# Recommended for lead classification. Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ─── Apollo.io ────────────────────────────────────────────────────────────────
# Primary enrichment source. Get from https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=

# ─── Hunter.io (enrichment fallback — optional) ───────────────────────────────
# If set, used as fallback when Apollo returns no email for a contact.
# Get a free key at https://hunter.io (1000 requests/month free).
HUNTER_API_KEY=

# ─── Email Verification — ZeroBounce (optional) ───────────────────────────────
# If not set, all enriched leads are advanced with email_status=unknown.
# Get a free key at https://zerobounce.net (100 credits/month free).
ZEROBOUNCE_API_KEY=

# ─── Slack Notifications (optional) ──────────────────────────────────────────
# Webhook URL for high-score lead alerts. If not set, Slack is silently skipped.
# Create one at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ─── Google Sheets ────────────────────────────────────────────────────────────
# Create a service account → share your Sheet with its email → paste the full
# credentials JSON here as a single-line stringified JSON, OR set the path:
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_CREDENTIALS_PATH=
# The ID of your Google Sheet (from the URL: /spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_ID=
# Sheet tab name (defaults to "Sheet1" if not set)
GOOGLE_SHEET_TAB_NAME=Sheet1

# ─── Gmail API / SMTP ─────────────────────────────────────────────────────────
# Option A – Gmail API (OAuth2): paste full OAuth2 credentials JSON (single-line)
GMAIL_API_CREDENTIALS_JSON=
# Option B – SMTP fallback (set USE_SMTP=true to activate)
USE_SMTP=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Digest ───────────────────────────────────────────────────────────────────
DIGEST_RECIPIENT_EMAIL=
DIGEST_FROM_EMAIL=noreply@jaqyi.com

# ─── Scheduler ────────────────────────────────────────────────────────────────
# Cron expression for daily run (default: 9 AM every day)
CRON_SCHEDULE=0 9 * * *

# ─── Scoring ──────────────────────────────────────────────────────────────────
# Leads scoring >= this trigger Slack notification + rep assignment. Default: 55.
# Can also be set in pipeline-config.json (code-free change).
SCORE_ALERT_THRESHOLD=55

# ─── Misc ─────────────────────────────────────────────────────────────────────
# Minimum buying intent score to pass through to enrichment (1–5, spec default: 3)
MIN_INTENT_SCORE=3
# Max leads to enrich per run (protects Apollo credits)
MAX_ENRICHMENTS_PER_RUN=50
# Number of days back to treat a lead as fresh
FRESHNESS_DAYS=2
